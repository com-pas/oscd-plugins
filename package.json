{
  "name": "@compas/oscd-plugins",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.20.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:oscd-publisher": "nx run --prod oscd-publisher:build --no-outputhashing --emptyOutDir --verbose",
    "run:oscd-publisher": "nx run oscd-publisher:serve",
    "preview:oscd-publisher": "nx run --prod oscd-publisher:preview",
    "test:all": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "check": "nx run-many --target=check",
    "verify": "nx run-many --target=lint,check,test"
  },
  "private": true,
  "dependencies": {
    "@compas-oscd/core": "^0.1.23",
    "@open-wc/scoped-elements": "^3.0.5",
    "@openenergytools/filterable-lists": "1.2.0",
    "@openenergytools/open-scd-core": "^0.0.5",
    "@openenergytools/scl-lib": "^1.2.3",
    "@openenergytools/tree-grid": "1.0.1",
    "@scopedelement/material-web": "3.10.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nx/eslint": "19.6.5",
    "@nx/eslint-plugin": "19.6.5",
    "@nx/js": "19.6.5",
    "@nx/vite": "19.6.5",
    "@nx/web": "19.6.5",
    "@nx/workspace": "19.6.5",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.1.1",
    "nx": "19.6.5",
    "prettier": "^3.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.4",
    "vitest": "^1.3.1"
  }
}
